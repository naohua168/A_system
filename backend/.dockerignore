# ============================================================
# Backend — .dockerignore
# 排除日志、IDE 配置、非必要文件
# ============================================================

# --- IDE ---
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- 日志 ---
logs/
*.log
*.gz

# --- 本地配置 (容器内使用环境变量覆盖) ---
src/main/resources/application-local.yml
src/main/resources/application-dev.yml
# application-prod.yml 需要打包进 JAR（容器通过 SPRING_PROFILES_ACTIVE=prod 激活）
# 内含 MySQL/Hive/Redis 生产配置

# --- Git ---
.git/
.gitignore
.gitattributes

# --- Docker ---
Dockerfile
Dockerfile.dev
