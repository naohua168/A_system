<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stock.mapper.InfoReportPdfMapper">

    <select id="selectByStock" resultType="com.stock.entity.InfoReportPdf">
        SELECT * FROM info_report_pdf
        WHERE stock_code = #{code}
        ORDER BY created_at DESC
    </select>

    <select id="selectByReportId" resultType="com.stock.entity.InfoReportPdf">
        SELECT * FROM info_report_pdf
        WHERE report_id = #{reportId}
        LIMIT 1
    </select>
</mapper>
