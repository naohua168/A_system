<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stock.mapper.InfoConsensusEpsMapper">

    <select id="selectByStock" resultType="com.stock.entity.InfoConsensusEps">
        SELECT * FROM info_consensus_eps
        WHERE stock_code = #{code}
        ORDER BY year DESC
    </select>

    <select id="selectByStockAndYear" resultType="com.stock.entity.InfoConsensusEps">
        SELECT * FROM info_consensus_eps
        WHERE stock_code = #{code}
          AND year = #{year}
        LIMIT 1
    </select>
</mapper>
