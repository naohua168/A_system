<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stock.mapper.InfoClsNewsMapper">

    <select id="selectLatest" resultType="com.stock.entity.InfoClsNews">
        SELECT * FROM info_cls_news
        ORDER BY publish_time DESC
        LIMIT #{limit}
    </select>

    <select id="selectSince" resultType="com.stock.entity.InfoClsNews">
        SELECT * FROM info_cls_news
        WHERE publish_time >= #{since}
        ORDER BY publish_time DESC
    </select>
</mapper>
