# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=stock_analysis
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379

# AI 服务配置
AI_SERVICE_URL=http://localhost:8000

# Docker MySQL 根密码（仅供 docker-compose 使用）
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# AI 服务 API 鉴权 Key（可选）
AI_API_KEY=your_ai_api_key

# Grafana 管理员密码
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ===== 前端开发环境 =====

# Vite 开发服务器端口（默认 5173）
VITE_PORT=5173

# WebSocket 连接地址（开发环境下指向后端端口，如 localhost:8082）
# 生产环境留空则自动使用当前页面 host
VITE_WS_HOST=localhost:8082
