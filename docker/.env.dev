# ============================================================
# Docker 开发环境变量配置
# 注意: 开发环境密码仅用于本地测试，部署生产前务必替换
# ============================================================

# ---------- 通用 ----------
COMPOSE_PROJECT_NAME=stock-analysis-dev

# ---------- MySQL ----------
# ⚠️ 开发环境默认密码，生产环境必须修改
MYSQL_ROOT_PASSWORD=hadoop123
MYSQL_DATABASE=stock_analysis
MYSQL_LOCAL_PORT=3307        # 宿主机端口（避开本地 3306）

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=8082
BACKEND_PROFILE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/stock_analysis?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=root
# ⚠️ 与 MYSQL_ROOT_PASSWORD 保持一致，生产环境务必同步修改
SPRING_DATASOURCE_PASSWORD=hadoop123
AI_SERVICE_URL=http://ai-service:8000

# ---------- Frontend ----------
FRONTEND_PORT=3000

# ---------- AI Service ----------
AI_SERVICE_PORT=8000
# SiliconFlow API Key（已配置，支持真实 AI 分析）
SILICONFLOW_API_KEY=sk-hbbicdzujyygrmnpwambsebxzifjkosfkeazrbtesceeerea
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
DEEPSEEK_API_KEY=
BACKEND_API_URL=http://backend:8082/api

# ---------- Hadoop ----------
HDFS_NAMENODE_PORT=9870
HDFS_RPC_PORT=9000
YARN_RM_PORT=8088
SPARK_MASTER_PORT=8080
SPARK_WORKER_PORT=8081
HIVE_PORT=10000
HIVE_WEBUI_PORT=10002

# ---------- 数据卷路径 ----------
DATA_ROOT=../data
