# ============================================================
# 生产环境配置（敏感信息请使用 Docker Secrets 或 Vault）
# 启动方式:
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
# ============================================================

# ====== 通用 ======
APP_VERSION=v1.0.0
TIMEZONE=Asia/Shanghai

# ====== MySQL ======
# ⚠️ 生产环境请替换为强密码
# 推荐: openssl rand -base64 32
MYSQL_USER=root
MYSQL_PASSWORD=changeme_strong_password_here
MYSQL_DATABASE=stock_analysis
MYSQL_LOCAL_PORT=3306

# ====== Redis ======
# ⚠️ 生产环境请设置强密码
REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379

# ====== AI 服务 ======
# 硅基流动 SiliconFlow API（推荐，OpenAI 兼容协议）
# 获取地址: https://cloud.siliconflow.cn
# ⚠️ 生产环境请替换为有效 Key
SILICONFLOW_API_KEY=sk-your-production-siliconflow-key
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
# DeepSeek API Key（备用，非必需）
DEEPSEEK_API_KEY=sk-your-production-deepseek-api-key
AI_SERVICE_PORT=8000

# ====== 后端 ======
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8082

# ====== 前端 ======
FRONTEND_PORT=80

# ====== 数据收集器 ======
LOG_LEVEL=INFO
# iwencai 语义搜索 (可选，不配置则不启用)
IWENCAI_API_KEY=
