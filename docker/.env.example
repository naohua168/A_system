# ============================================================
# A_system 环境变量配置示例
# 复制此文件为 .env 或 .env.production 并根据环境修改
#
# 使用方法:
#   cp .env.example .env          # 开发环境
#   cp .env.example .env.production # 生产环境
#
#   启动时自动加载:
#   docker compose --env-file .env.production up -d
# ============================================================

# ====== 通用 ======
APP_VERSION=latest
TIMEZONE=Asia/Shanghai

# ====== MySQL 数据库 ======
MYSQL_USER=root
MYSQL_PASSWORD=hadoop123
MYSQL_DATABASE=stock_analysis
MYSQL_ROOT_PASSWORD=hadoop123

# ====== Redis 缓存 ======
REDIS_PASSWORD=
REDIS_PORT=6379

# ====== AI 服务 ======
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
AI_SERVICE_PORT=8000

# ====== 后端 ======
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8082

# ====== 前端 ======
FRONTEND_PORT=80

# ====== 端口映射（宿主机端口）=====
MYSQL_LOCAL_PORT=3307
