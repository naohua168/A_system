# ============================================================
# Backend Dev Dockerfile — 使用本地预构建 JAR
# 构建上下文: ../backend (即 f:/bs/A_system/backend/)
# ============================================================
FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache curl

WORKDIR /app

# 从 target/ 拷贝预构建 JAR（上下文是 backend/）
COPY target/stock-analysis-backend-1.0.0.jar app.jar

EXPOSE 8082

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD curl -sf http://localhost:8082/api/user/login -X POST -H "Content-Type: application/json" -d '{"username":"admin","password":"admin123"}' || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]
