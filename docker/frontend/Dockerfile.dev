# ============================================================
# Docker 开发环境 — Frontend (Vue 3 + Vite HMR)
# 修复: context=项目根目录，COPY路径加 frontend/ 前缀
# ============================================================

FROM node:20-alpine

WORKDIR /app

# 先拷贝依赖描述文件，利用 Docker 缓存
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install

# 拷贝 Vite 配置
COPY frontend/vite.config.ts frontend/tsconfig.json frontend/tsconfig.node.json ./

# 暴露 Vite 开发服务器端口
EXPOSE 3000

# ====== 启动命令 ======
# Vite 开发服务器配置:
#   --host 0.0.0.0: 监听所有网络接口（Docker 内必须）
#   --port 3000:     固定端口
#   --strictPort:    端口被占用时报错而非自动切换
#
# HMR 工作原理:
#   1. Vite 监听源码变更 -> WebSocket 推送更新到浏览器
#   2. 仅替换变更的模块，保持应用状态
#   3. 宿主文件变更通过 bind mount 同步到容器 /app/src
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "3000", "--strictPort"]