  "infrastructure_services": {
    "_comment": "基础设施服务凭据 — 用于 Docker 容器间通信和运维管理",
    "database": {
      "mysql": {
        "service": "MySQL 8.0 业务数据库",
        "host": "mysql",
        "port": 3306,
        "host_port": 3307,
        "database": "stock_analysis",
        "username": "root",
        "password": "hadoop123",
        "connection_url": "jdbc:mysql://localhost:3307/stock_analysis?serverTimezone=Asia/Shanghai",
        "docker_exec": "docker exec mysql mysql -uroot -phadoop123 -e \"SELECT 1;\"",
        "_local_dev": {
          "host": "localhost",
          "port": 3306,
          "password": "123456",
          "connection_url": "jdbc:mysql://localhost:3306/stock_analysis?serverTimezone=Asia/Shanghai"
        }
      },
      "redis": {
        "service": "Redis 7 缓存服务",
        "host": "redis",
        "port": 6379,
        "host_port": 6379,
        "password": "",
        "_note": "Redis 默认无密码认证，仅供内网访问"
      }
    },
    "authentication": {
      "jwt": {
        "service": "JWT 令牌认证",
        "algorithm": "HS256",
        "secret": "DefaultSecretKeyForAStockSystem2026DevEnvironment",
        "expiration_ms": 86400000,
        "expiration_label": "24 小时",
        "_warning": "此为开发环境默认密钥，生产环境请务必修改"
      },
      "password_hash": {
        "algorithm": "BCrypt",
        "strength": 10
      }
    },
    "ai_service": {
      "deepseek": {
        "service": "DeepSeek API (可选)",
        "api_url": "https://api.deepseek.com/v1/chat/completions",
        "api_key": "",
        "model": "deepseek-chat",
        "_note": "不配置 API Key 时自动使用模拟回复模式"
      },
      "kimi": {
        "api_url": "https://api.moonshot.cn/v1/chat/completions",
        "api_key": "",
        "_note": "备用 AI 模型"
      }
    },
    "bigdata": {
      "hdfs": {
        "service": "Hadoop HDFS 分布式文件系统",
        "name_node_webui": "http://localhost:9870",
        "name_node_rpc": "hdfs://namenode:9000",
        "cluster_name": "stock_cluster",
        "docker_exec": {
          "ls": "docker exec namenode hdfs dfs -ls /",
          "put": "docker exec namenode hdfs dfs -put /data/collector_output /user/hadoop/"
        }
      },
      "yarn": {
        "service": "Apache Hadoop YARN",
        "resource_manager_webui": "http://localhost:8088",
        "docker_exec": "docker exec resourcemanager yarn node -list"
      },
      "hive": {
        "service": "Apache Hive 数据仓库",
        "server2_jdbc": "jdbc:hive2://localhost:10000",
        "web_ui": "http://localhost:10002",
        "docker_exec": "docker exec hive-server /opt/hive/bin/beeline -u jdbc:hive2://localhost:10000 -e \"SHOW DATABASES;\""
      },
      "spark": {
        "service": "Apache Spark 计算引擎",
        "master_webui": "http://localhost:8080",
        "worker_webui": "http://localhost:8081",
        "master_rpc": "spark://spark-master:7077",
        "docker_exec": "docker exec spark-master /opt/spark/bin/spark-submit --master spark://spark-master:7077 --class org.apache.spark.examples.SparkPi /opt/spark/examples/jars/spark-examples_2.12-3.5.0.jar 10"
      }
    }
  },

  "quick_reference": {
    "_comment": "常见操作命令速查",
    "start_system": "cd f:/bs/A_system/docker && docker compose up -d",
    "stop_system": "cd f:/bs/A_system/docker && docker compose down",
    "view_logs": "cd f:/bs/A_system/docker && docker compose logs -f",
    "verify_containers": "docker compose ps",
    "check_mysql": "docker exec mysql mysql -uroot -phadoop123 -e \"USE stock_analysis; SHOW TABLES;\"",
    "check_hdfs": "docker exec namenode hdfs dfs -ls /",
    "collect_data": "python data-collector/scheduler/market_collect.py --standalone",
    "run_pipeline": "python bigdata-processing/batch/run_batch_pipeline.py --mode daily",
    "e2e_verify": "python scripts/e2e_verify.py",
    "backend_dev": "cd backend && mvn spring-boot:run",
    "frontend_dev": "cd frontend && npm run dev",
    "ai_dev": "cd ai-service && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
  }
}
