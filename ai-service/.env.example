# AI 服务环境变量配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API（可选，不配置时自动使用模拟回复模式）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Kimi API（备用 AI 模型，可选）
KIMI_API_KEY=your_kimi_api_key_here

# AI 服务 API 鉴权 Key（可选，不配置时放行所有请求）
AI_API_KEY=your_ai_service_api_key

# 后端行情 API
BACKEND_API_URL=http://localhost:8082/api

# Redis 配置（可选，用于记忆持久化，留空时回退到文件存储）
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
