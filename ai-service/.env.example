# Kimi API 配置（可选）
KIMI_API_KEY=
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions

# 后端服务地址（用于获取行情数据上下文）
BACKEND_API_URL=http://localhost:8080/api
