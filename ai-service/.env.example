# AI 服务环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 日志级别（DEBUG / INFO / WARNING / ERROR） ──
LOG_LEVEL=INFO

# ── DeepSeek API（可选，不配置时自动使用模拟回复模式） ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── 硅基流动 SiliconFlow API（OpenAI 兼容协议，推荐使用） ──
# 获取地址: https://cloud.siliconflow.cn
# 推荐模型: Qwen/Qwen2.5-32B-Instruct, deepseek-ai/DeepSeek-V3
# 获取地址: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct

# ── AI 服务 API 鉴权 Key（可选，不配置时放行所有请求） ──
AI_API_KEY=your_ai_service_api_key

# ── 后端行情 API（注意：L4 后端实际端口为 8082） ──
BACKEND_API_URL=http://localhost:8082/api

# ── Redis 配置（可选，用于记忆持久化，留空时回退到文件存储） ──
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
